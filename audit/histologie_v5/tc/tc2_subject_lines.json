    "page": 1,
    "text": "Wharton ",
    "bbox": [
      106.94999694824219,
      501.35076904296875,
      153.21200561523438,
      513.3507690429688
    ]
  },
  {
    "page": 1,
    "text": "C. il n’existe plus chez l’adulte ",
    "bbox": [
      88.94999694824219,
      516.000732421875,
      242.91200256347656,
      528.000732421875
    ]
  },
  {
    "page": 1,
    "text": "D. il ne contient pas de cellules ",
